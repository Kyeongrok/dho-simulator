<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <RootNamespace>Dho</RootNamespace>
        <!-- 실행 파일의 아이콘: 게임 폴더의 원본 아이콘이 있으면 그것을 쓴다(저장소에는 두지 않는다) -->
        <GameIcon>C:\Netmarble\GV Online Kr\GVOnline.ico</GameIcon>
        <ApplicationIcon Condition="Exists('$(GameIcon)')">$(GameIcon)</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NVorbis" Version="0.10.5" />
        <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dho.Data\Dho.Data.csproj" />
    </ItemGroup>

</Project>
