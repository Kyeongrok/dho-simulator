<Window x:Class="Dho.Tools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="대항해시대 온라인 개발도구" Width="1280" Height="820">
    <DockPanel>
        <!-- 위: 저장 · 다시 뽑기 · 게임 실행 -->
        <Border DockPanel.Dock="Top" Padding="8" Background="#FF1C2A5A">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="저장 (Ctrl+S)" Click="Save_Click" />
                    <Button Content="게임 실행" Click="RunGame_Click" />
                    <Button Content="게임 자료에서 다시 뽑기" Click="Extract_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="6">
            <!-- 의뢰 -->
            <TabItem Header="의뢰">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="새 의뢰" Click="AddQuest_Click" />
                            <Button Content="지우기" Click="RemoveQuest_Click" />
                        </StackPanel>
                        <ListBox x:Name="QuestList" SelectionChanged="QuestList_SelectionChanged" />
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="QuestForm">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="번호" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Id}" Width="80" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Text="제목" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" TextChanged="QuestTitle_TextChanged" />
                            <TextBlock Grid.Row="2" Text="의뢰인" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Client}" />
                            <TextBlock Grid.Row="3" Text="조합 마스터의 말" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Request}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                            <TextBlock Grid.Row="4" Text="목표 한 줄" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Hint}" />
                            <TextBlock Grid.Row="5" Text="받는 도시" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="QuestCity" Margin="0,2" DisplayMemberPath="Label"
                                      SelectedValuePath="Id" SelectedValue="{Binding CityId}" IsEditable="True" IsTextSearchEnabled="True" />
                            <TextBlock Grid.Row="6" Text="발견물" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="QuestDiscovery" Margin="0,2" DisplayMemberPath="Label"
                                      SelectedValuePath="Id" SelectedValue="{Binding DiscoveryId}" IsEditable="True" IsTextSearchEnabled="True"
                                      SelectionChanged="QuestDiscovery_SelectionChanged" />
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DiscoveryInfo" TextWrapping="Wrap" Foreground="#FF505050" Margin="0,2,0,6" />
                            <TextBlock Grid.Row="8" Text="상륙지" Style="{StaticResource Label}" />
                            <DockPanel Grid.Row="8" Grid.Column="1">
                                <Button DockPanel.Dock="Right" Content="지도에서 자리 찍기" Margin="6,2,0,2" Click="PickLanding_Click" />
                                <ComboBox x:Name="QuestLanding" Margin="0,2" DisplayMemberPath="Label" SelectedValuePath="Id"
                                          SelectedValue="{Binding LandingId}" IsEditable="True" IsTextSearchEnabled="True" />
                            </DockPanel>
                            <TextBlock Grid.Row="9" Text="상륙했을 때 글" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding LandingText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                            <TextBlock Grid.Row="10" Text="선금" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Advance}" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="11" Text="보수" Style="{StaticResource Label}" />
                            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Reward}" Width="120" HorizontalAlignment="Left" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 지도 -->
            <TabItem Header="지도">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="찍을 상륙지" Style="{StaticResource Label}" />
                        <ComboBox x:Name="MapLanding" Width="260" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="True"
                                  SelectionChanged="MapLanding_SelectionChanged" />
                        <TextBlock Text="확대" Style="{StaticResource Label}" Margin="16,0,8,0" />
                        <Slider x:Name="ZoomSlider" Width="160" Minimum="0.25" Maximum="12" Value="1" ValueChanged="Zoom_ValueChanged" VerticalAlignment="Center" />
                        <Button Content="도시로 가기" Margin="16,0,6,0" Click="GoToCity_Click" />
                        <ComboBox x:Name="MapCity" Width="160" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="True" />
                        <TextBlock x:Name="MapInfo" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="#FF505050"
                               Text="왼쪽 클릭: 고른 상륙지의 자리를 그곳으로 · 빨강 = 항구 앞바다, 노랑 = 자리를 찍어 둔 상륙지, 초록 = 뭍(통행 판정 지도)" />
                    <ScrollViewer x:Name="MapScroll" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Background="#FF101830">
                        <Grid x:Name="MapGrid" Width="4096" Height="2048" HorizontalAlignment="Left" VerticalAlignment="Top"
                              MouseMove="Map_MouseMove" MouseLeftButtonDown="Map_MouseLeftButtonDown">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1" />
                            </Grid.LayoutTransform>
                            <Image x:Name="MapImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Canvas x:Name="MapMarks" IsHitTestVisible="False" />
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="상륙지">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="찾기" Style="{StaticResource Label}" />
                        <TextBox Tag="Landings" TextChanged="Filter_TextChanged" />
                    </DockPanel>
                    <DataGrid x:Name="LandingGrid" AutoGenerateColumns="True" CanUserAddRows="False" />
                </DockPanel>
            </TabItem>

            <TabItem Header="도시">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="찾기" Style="{StaticResource Label}" />
                        <TextBox Tag="Cities" TextChanged="Filter_TextChanged" />
                    </DockPanel>
                    <DataGrid x:Name="CityGrid" AutoGenerateColumns="True" CanUserAddRows="False" />
                </DockPanel>
            </TabItem>

            <TabItem Header="발견물">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="찾기" Style="{StaticResource Label}" />
                        <TextBox Tag="Discoveries" TextChanged="Filter_TextChanged" />
                    </DockPanel>
                    <DataGrid x:Name="DiscoveryGrid" AutoGenerateColumns="True" CanUserAddRows="False" EnableRowVirtualization="True" MaxColumnWidth="560" />
                </DockPanel>
            </TabItem>

            <TabItem Header="해역">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FF505050"
                               Text="위: 해역마다의 바다(지은 값, sea-climates.json). 방향은 나침반 각도(0 북 · 90 동)이고 불어 가는 쪽 / 흘러가는 쪽. WindSwing 은 좌우로 흔들리는 너비(도), Seasonal 은 철 따라 뒤집히는 몬순, Storm 은 폭풍 잦기의 배수, Rain 은 비 올 몫(0 ~ 1), Wave 는 물결 높이의 배수. 아래: 클라이언트 표 8 의 해역(이름 · 대해역 · 배경음)." />
                    <DataGrid x:Name="SeaGrid" DockPanel.Dock="Bottom" AutoGenerateColumns="True" CanUserAddRows="False" Height="220" />
                    <DataGrid x:Name="ClimateGrid" AutoGenerateColumns="True" CanUserAddRows="True" />
                </DockPanel>
            </TabItem>

            <TabItem Header="재해">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FF505050"
                               Text="이름·알림 글은 클라이언트 화면 글(dt000002)의 id 로 가리킨다(StateText·StartText·EndText). 확률(하루)·피해(하루)·속도 배수는 지은 값. CureSupply 는 대처하는 보급품 번호." />
                    <DataGrid x:Name="SupplyGrid" DockPanel.Dock="Bottom" AutoGenerateColumns="True" CanUserAddRows="True" Height="170" />
                    <TextBlock DockPanel.Dock="Bottom" Text="보급품" FontWeight="Bold" Margin="0,8,0,4" />
                    <DataGrid x:Name="DisasterGrid" AutoGenerateColumns="True" CanUserAddRows="True" />
                </DockPanel>
            </TabItem>

            <TabItem Header="스킬">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#FF505050"
                               Text="위: 스킬이 게임에서 하는 일(지은 값). Effect = Speed·Turn·Survey·Find·Appraise·CrewLoss·Cure·Rest·Discount. Targets 는 발견물 갈래 번호(Find·Appraise) 또는 재해 번호(Cure). 아래: 클라이언트 표 6 의 스킬(이름·설명·습득 비용)." />
                    <DataGrid x:Name="SkillGrid" DockPanel.Dock="Bottom" AutoGenerateColumns="True" CanUserAddRows="False" Height="300" MaxColumnWidth="520" />
                    <DataGrid x:Name="SkillRuleGrid" AutoGenerateColumns="False" CanUserAddRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SkillId" Binding="{Binding SkillId}" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Effect" Binding="{Binding Effect}" />
                            <DataGridTextColumn Header="PerRank" Binding="{Binding PerRank}" />
                            <DataGridTextColumn Header="Targets" Binding="{Binding TargetsText}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="배">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Right" Width="420" Margin="10,0,0,0">
                        <TextBlock Text="능력치를 지어 내는 계수" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid x:Name="ShipRulesForm" />
                    </StackPanel>
                    <DataGrid x:Name="ShipGrid" AutoGenerateColumns="True" CanUserAddRows="False" MaxColumnWidth="360" />
                </DockPanel>
            </TabItem>

            <TabItem Header="교역">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Right" Width="420" Margin="10,0,0,0">
                        <TextBlock Text="값 셈의 계수 (갈래별 기준값은 settings.json 의 Trade.KindPrices)" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <Grid x:Name="TradeRulesForm" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="도시가 파는 품목 (Goods = 교역품 번호를 쉼표로). 비워 두고 저장하면 자동으로 채운다." Margin="0,0,0,4" Foreground="#FF505050" />
                    <DataGrid x:Name="GoodGrid" DockPanel.Dock="Bottom" AutoGenerateColumns="True" CanUserAddRows="False" Height="260" MaxColumnWidth="420" />
                    <DataGrid x:Name="MarketGrid" AutoGenerateColumns="True" CanUserAddRows="False" />
                </DockPanel>
            </TabItem>

            <TabItem Header="조선">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="재질(위) · 강화 부품(가운데) · 옵션 스킬(아래). 배율과 조합은 원본 자료, 필요 랭크 · 값 · 효과 크기는 지은 값이다." />
                    <DataGrid x:Name="OptionSkillGrid" DockPanel.Dock="Bottom" AutoGenerateColumns="True" CanUserAddRows="True" Height="220" />
                    <DataGrid x:Name="ShipMaterialGrid" DockPanel.Dock="Top" AutoGenerateColumns="True" CanUserAddRows="True" Height="190" />
                    <DataGrid x:Name="WorkPartGrid" AutoGenerateColumns="True" CanUserAddRows="True" />
                </DockPanel>
            </TabItem>

            <TabItem Header="칙명 · 아이템">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="칙명(위) · 소비 아이템(아래). 칙명의 Kind: Visit · Far · Bring(Target = 교역품 갈래) · Discover. 아이템의 Effect: Fatigue · Repair · Cure(Amount = 재해 번호) · Lifebuoy." />
                    <DataGrid x:Name="ItemGrid" DockPanel.Dock="Bottom" AutoGenerateColumns="True" CanUserAddRows="True" Height="240" />
                    <DataGrid x:Name="OrderGrid" AutoGenerateColumns="True" CanUserAddRows="True" MaxColumnWidth="520" />
                </DockPanel>
            </TabItem>

            <TabItem Header="레시피">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="생산 규칙(위): Output = 교역품 번호, Inputs = '교역품 번호:수' 를 쉼표로, Skill = '조리 3' 꼴. 아래는 클라이언트의 레시피 이름 표(읽기용)." />
                    <DataGrid x:Name="RecipeNameGrid" DockPanel.Dock="Bottom" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True" Height="240" MaxColumnWidth="520" />
                    <DataGrid x:Name="RecipeRuleGrid" AutoGenerateColumns="True" CanUserAddRows="True" />
                </DockPanel>
            </TabItem>

            <TabItem Header="효과음">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" TextWrapping="Wrap" Text="원본 효과음 목록(0006\001000 · 002000). 줄을 누르면 들린다. 소리에 이름표가 없어서 들어 보고 골라야 한다 — 맞는 줄을 고른 뒤 아래 단추로 게임의 일에 맨다(Ctrl+S 로 저장)." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="다시 듣기" Click="SoundPlay_Click" Padding="10,3" />
                        <Button Content="멈춤" Click="SoundStop_Click" Padding="10,3" Margin="6,0,0,0" />
                        <Button Content="선회 소리로" Tag="Turn" Click="SoundAssign_Click" Padding="10,3" Margin="20,0,0,0" />
                        <Button Content="돛 조종 소리로" Tag="Sail" Click="SoundAssign_Click" Padding="10,3" Margin="6,0,0,0" />
                        <Button Content="그 밖의 스킬 소리로" Tag="Skill" Click="SoundAssign_Click" Padding="10,3" Margin="6,0,0,0" />
                        <TextBlock x:Name="SoundAssigned" Margin="16,4,0,0" />
                    </StackPanel>
                    <DataGrid x:Name="SoundGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionChanged="SoundGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="번호" Binding="{Binding Key, Mode=OneWay}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="묶음" Binding="{Binding Bank, Mode=OneWay}" IsReadOnly="True" Width="50" />
                            <DataGridTextColumn Header="차례" Binding="{Binding Index, Mode=OneWay}" IsReadOnly="True" Width="50" />
                            <DataGridTextColumn Header="길이(초)" Binding="{Binding Seconds, Mode=OneWay, StringFormat=0.00}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="표본율" Binding="{Binding Rate, Mode=OneWay}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="채널" Binding="{Binding Channels, Mode=OneWay}" IsReadOnly="True" Width="50" />
                            <DataGridTextColumn Header="메모 (두 번 눌러 적는다)" Binding="{Binding Memo, UpdateSourceTrigger=LostFocus}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="시작">
                <StackPanel Margin="8" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="시작 도시 덮어쓰기 (0 = 나라의 본거지)" Style="{StaticResource Label}" />
                        <TextBox x:Name="CityOverrideBox" Width="80" />
                        <Button Content="이어 하기 지우기 (다음 실행 때 캐릭터 만들기)" Margin="20,0,0,0" Click="DeleteSave_Click" />
                    </StackPanel>
                    <TextBlock Text="직업 계열별 시작 조건 (지은 값) — Skills 는 스킬 번호를 쉼표로" FontWeight="Bold" Margin="0,0,0,4" />
                    <DataGrid x:Name="StartLineGrid" AutoGenerateColumns="True" CanUserAddRows="False" Height="130" />
                    <TextBlock Text="나라와 시작 도시" FontWeight="Bold" Margin="0,10,0,4" />
                    <DataGrid x:Name="StartNationGrid" AutoGenerateColumns="True" CanUserAddRows="True" Height="220" />
                </StackPanel>
            </TabItem>

            <TabItem Header="설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" MaxWidth="640" HorizontalAlignment="Left">
                        <Grid x:Name="SettingsForm" />
                        <TextBlock Text="배 살림과 날씨 (지은 값)" FontWeight="Bold" Margin="0,14,0,4" />
                        <Grid x:Name="RulesForm" />
                        <TextBlock Text="항구 장면에서 배가 뜨는 자리 (장면 번호 · X · Z · 뱃머리 각)" FontWeight="Bold" Margin="0,14,0,4" />
                        <DataGrid x:Name="BerthGrid" AutoGenerateColumns="True" CanUserAddRows="True" MinHeight="120" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
